# انسخه إلى .dev.vars للتطوير المحلي (لا يُرفع — في .gitignore).
# على السحابة تُضبط بـ: wrangler secret put <NAME>

# بيانات دخول لوحة التحكم.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please

# سرّ توقيع كوكي الجلسة — أي نص عشوائي طويل.
AUTH_SECRET=generate-a-long-random-string

# سرّ مشترك بين الـ Worker والجالب المحلي (fetcher/.env) — أي نص عشوائي طويل.
INGEST_TOKEN=generate-another-long-random-string
