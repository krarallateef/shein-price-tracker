{
  // ⚠️ مشروع مستقل تماماً — لا علاقة له بـ KIDA. اسم Worker فريد، دومين workers.dev فقط،
  // قاعدة D1 خاصة. لا يمكن أن يكتب فوق أي شيء في حساب KIDA.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shein-price-tracker",
  "main": "src/index.js",
  "compatibility_date": "2025-01-15",

  // كل دقيقة — أقصى تكرار عملي. كل تشغيل يفحص دفعة صغيرة (BATCH_SIZE) من أقدم
  // المنتجات فحصاً، فتدور على الكل. مجاني: 3 كرون/Worker كحد أقصى، 10ms CPU/تشغيل.
  "triggers": {
    "crons": ["* * * * *"]
  },

  "vars": {
    // عدد المنتجات المفحوصة كل دقيقة. 6 = آمن جداً لحد الـ 10ms CPU وحد الـ 50 طلب فرعي.
    // ارفعه لو عندك منتجات كثيرة وتريد دورة أسرع (راقب سجلّ الأخطاء).
    "BATCH_SIZE": "6",
    // لا تُرسل تنبيهاً إلا إذا تغيّر السعر بنسبة تفوق هذا (٪) — يكبح ضجيج التذبذب.
    "MIN_CHANGE_PCT": "3",
    // بعد هذا العدد من الإخفاقات المتتالية، يُباعد فحص المنتج (backoff) ويُنبَّه مرة.
    "MAX_FAILURES": "5"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shein-tracker-db",
      "database_id": "PASTE_AFTER_wrangler_d1_create"
    }
  ],

  "observability": { "enabled": true }
}
